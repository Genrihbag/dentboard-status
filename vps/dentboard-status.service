[Unit]
Description=DentBoard: проверка доступности (один круг)
Documentation=file:/opt/dentboard-status/vps/README.md
# Сеть нужна — она и есть предмет проверки. Без неё круг честно провалится, но провалится ЗРЯ.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dentboard-status
# ⚠️ ЗОВЁМ ЧЕРЕЗ `bash`, А НЕ НАПРЯМУЮ — и это не перестраховка, а починка боевого отказа
# 29.08.2026: `status=203/EXEC`, systemd не смог запустить файл. Бит исполнения не доехал до git
# (`100644`), потому что `chmod +x` делался на Windows — команда отработала успешно и НЕ ПРОИЗВЕЛА
# действия, видимого репозиторию. Классический случай: инструмент отчитался о выполнении, а не о
# результате.
#
# Бит в индексе теперь выставлен, но вызов через `bash` снимает вопрос целиком: он переживёт и
# потерянный бит, и файловую систему, смонтированную `noexec`.
ExecStart=/bin/bash /opt/dentboard-status/tick.sh
# Секреты — файлом, а не в юните: юнит лежит в git, файл нет.
EnvironmentFile=/etc/dentboard-status.env
# Куда класть готовую страницу. Задано — публикуем на свой nginx КАЖДЫЙ круг и в git не ходим:
# запись на локальный диск ничего не стои́т, поэтому экономить нечего.
Environment=SITE_DIR=/var/www/status
User=status
Group=status

# ⚠️ ТАЙМАУТ КОРОЧЕ ИНТЕРВАЛА ТИКА. Круг с четырьмя целями по три попытки и таймаутом 15 с может
# в худшем случае занять три минуты; зависший круг наложился бы на следующий, и два процесса
# начали бы толкаться в одном git-репозитории. Пятидесяти секунд хватает на здоровый круг, а
# больной обязан быть убит, а не растянут.
TimeoutStartSec=50
