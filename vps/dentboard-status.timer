[Unit]
Description=DentBoard: круг проверки доступности раз в минуту

[Timer]
# ⚠️ РОВНАЯ СЕТКА, А НЕ «ЧЕРЕЗ МИНУТУ ПОСЛЕ КОНЦА». `OnCalendar` считает от календаря, поэтому
# длительность круга не смещает следующий — в отличие от `OnUnitActiveSec`, где у сторожа сети
# минута фактически превратилась в семьдесят секунд. Наложение исключено `TimeoutStartSec` в юните.
OnCalendar=*:0/1
# Первый круг — через полминуты после загрузки: раньше сеть ещё поднимается, и проверка посчитала
# бы это отказом наблюдаемого.
OnBootSec=30s
AccuracySec=1s
# ⚠️ БЕЗ `Persistent=true` НАМЕРЕННО. Догонять пропущенные круги здесь вредно: после простоя машина
# выполнила бы их пачкой, разом отправив в канал сообщения о давно прошедших событиях.

[Install]
WantedBy=timers.target
